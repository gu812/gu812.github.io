extends includes/layout.pug

block content
  //- YAML 里写 type: 404 会被解析成数字 404，统一转字符串再比较
  - const pageTypeStr = String(page.type ?? '')
  - const noCardLayout = ['shuoshuo', '404'].includes(pageTypeStr) ? 'nc' : ''
  //- 404 保留自己的 title，用来当作页面上那个大号「404」
  - const hidePageTitle = pageTypeStr === 'shuoshuo'
  - var commentsJsLoad = false

  mixin commentLoad
    if page.comments !== false && theme.comments.use
      - commentsJsLoad = true
      !=partial('includes/third-party/comments/index', {}, {cache: true})

  #page(class=noCardLayout)
    if top_img === false && page.title && !hidePageTitle
      .page-title= page.title

    case page.type
      when 'tags'
        include includes/page/tags.pug
        +commentLoad
      when 'link'
        include includes/page/flink.pug
        +commentLoad
      when 'categories'
        include includes/page/categories.pug
        +commentLoad
      when '404'
        include includes/page/404.pug
      when 'shuoshuo'
        include includes/page/shuoshuo.pug
      default
        include includes/page/default-page.pug
        +commentLoad